{
  "manifest_version": 3,
  "name": "CivicPulse — Fact & Misinformation Intelligence",
  "version": "1.2.2",
  "description": "Evidence-grounded fact checking with automatic red highlighting for live-search claims flagged as false.",
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://civic-pluse-sooty.vercel.app/*",
    "https://web.whatsapp.com/*",
    "https://*.instagram.com/*",
    "https://*.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*",
        "https://*.instagram.com/*",
        "https://*.youtube.com/*",
        "https://civic-pluse-sooty.vercel.app/*"
      ],
      "js": ["evidence-result.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CivicPulse AI Fact-Checker"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
