# Copy to backend/.env and fill in secrets locally. Never commit backend/.env.
GROQ_API_KEY=
# Primary fact-checking uses Groq browser search; choose a browser-search-capable model.
GROQ_FACT_CHECK_MODEL=openai/gpt-oss-20b
# Optional automatic fallback when Groq is rate-limited or returns no usable citations.
# Create a fresh Gemini key in Google AI Studio; never paste keys into source code or chat.
GEMINI_API_KEY=
GEMINI_FACT_CHECK_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=60
GROQ_RATE_LIMIT_COOLDOWN_SECONDS=60
CIVICPULSE_API_KEY=
CLIENT_INGEST_TOKEN=

# Set this to the exact ID shown for your unpacked extension in chrome://extensions.
# Example format: chrome-extension://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
# For a Web Store release, use the published extension ID.
CHROME_EXTENSION_ORIGIN=

# Dashboard origins allowed to call this backend.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173,https://civic-pluse-sooty.vercel.app
HOST=127.0.0.1
PORT=8000

# Optional; enables local Hugging Face models and increases startup time/memory use.
CIVICPULSE_LOAD_LOCAL_MODELS=false
